<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
    <FileVersion major="1" minor="6" />
    <Project>
        <Option title="cool_lexer" />
        <Option pch_mode="2" />
        <Option compiler="gcc" />
        <Build>
            <Target title="Debug">
                <!--
                    Output and working_dir use ~/PA1 symlink (no spaces in path).
                    CodeBlocks on macOS uses osascript to open Terminal, which
                    breaks when the path contains spaces — the symlink bypasses this.
                -->
                <Option output="/Users/stefanoknez/PA1/bin/Debug/cool_lexer" prefix_auto="1" extension_auto="1" />
                <Option working_dir="/Users/stefanoknez/PA1" />
                <Option parameters="/Users/stefanoknez/PA1_test.cl" />
                <Option type="1" />
                <Option compiler="gcc" />
                <Option createDefines="0" />
                <Compiler>
                    <Add option="-std=c++11" />
                    <Add option="-Wall" />
                    <Add option="-Wno-unused-function" />
                    <Add option="-g" />
                </Compiler>
                <ExtraCommands>
                    <Add before="bash &quot;$(PROJECT_DIR)run_flex.sh&quot;" />
                </ExtraCommands>
            </Target>
            <Target title="Release">
                <Option output="/Users/stefanoknez/PA1/bin/Release/cool_lexer" prefix_auto="1" extension_auto="1" />
                <Option working_dir="/Users/stefanoknez/PA1" />
                <Option parameters="/Users/stefanoknez/PA1_test.cl" />
                <Option type="1" />
                <Option compiler="gcc" />
                <Option createDefines="0" />
                <Compiler>
                    <Add option="-std=c++11" />
                    <Add option="-O2" />
                    <Add option="-Wno-unused-function" />
                </Compiler>
                <ExtraCommands>
                    <Add before="bash &quot;$(PROJECT_DIR)run_flex.sh&quot;" />
                </ExtraCommands>
            </Target>
        </Build>
        <Compiler>
            <Add option="-std=c++11" />
            <Add option="-Wall" />
            <Add option="-Wno-unused-function" />
        </Compiler>
        <Unit filename="cool.flex">
            <Option compile="0" />
            <Option link="0" />
        </Unit>
        <Unit filename="lex.yy.cc">
            <Option compilerVar="CPP" />
        </Unit>
        <Unit filename="stringtab.cc">
            <Option compilerVar="CPP" />
        </Unit>
        <Unit filename="utilities.cc">
            <Option compilerVar="CPP" />
        </Unit>
        <Unit filename="main.cc">
            <Option compilerVar="CPP" />
        </Unit>
        <Unit filename="cool-parse.h">
            <Option compile="0" />
            <Option link="0" />
        </Unit>
        <Unit filename="stringtab.h">
            <Option compile="0" />
            <Option link="0" />
        </Unit>
        <Unit filename="utilities.h">
            <Option compile="0" />
            <Option link="0" />
        </Unit>
        <Unit filename="run_flex.sh">
            <Option compile="0" />
            <Option link="0" />
        </Unit>
        <Unit filename="test.cl">
            <Option compile="0" />
            <Option link="0" />
        </Unit>
        <Extensions />
    </Project>
</CodeBlocks_project_file>
