<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="cool_lexer" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<!-- type=4 : Commands only — CB never tries to link or auto-run the binary.
				     All building is handled by run_flex.sh (before step).
				     Opening the terminal is handled by PA1_open_terminal.sh (after step). -->
				<Option output="bin/Debug/cool_lexer" prefix_auto="0" extension_auto="0" />
				<Option working_dir="" />
				<Option type="4" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-std=c++11" />
					<Add option="-Wall" />
					<Add option="-Wno-unused-function" />
					<Add option="-g" />
				</Compiler>
				<ExtraCommands>
					<!-- Before: flex -> make -> copy binary to bin/Debug/cool_lexer -->
					<Add before='bash &quot;$(PROJECT_DIR)run_flex.sh&quot;' />
					<!-- After: open a Terminal window that runs the lexer on test.cl -->
					<Add after="bash /Users/stefanoknez/PA1_open_terminal.sh" />
				</ExtraCommands>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/cool_lexer" prefix_auto="0" extension_auto="0" />
				<Option working_dir="" />
				<Option type="4" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-std=c++11" />
					<Add option="-O2" />
					<Add option="-Wno-unused-function" />
				</Compiler>
				<ExtraCommands>
					<Add before='bash &quot;$(PROJECT_DIR)run_flex.sh&quot;' />
					<Add after="bash /Users/stefanoknez/PA1_open_terminal.sh" />
				</ExtraCommands>
			</Target>
		</Build>
		<Compiler>
			<Add option="-std=c++11" />
			<Add option="-Wall" />
			<Add option="-Wno-unused-function" />
		</Compiler>
		<Unit filename="cool-parse.h" />
		<Unit filename="cool.flex" />
		<Unit filename="lex.yy.cc" />
		<Unit filename="main.cc" />
		<Unit filename="run_flex.sh" />
		<Unit filename="stringtab.cc" />
		<Unit filename="stringtab.h" />
		<Unit filename="test.cl" />
		<Unit filename="utilities.cc" />
		<Unit filename="utilities.h" />
		<Extensions />
	</Project>
</CodeBlocks_project_file>
