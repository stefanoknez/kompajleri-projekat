<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
    <FileVersion major="1" minor="6" />
    <Project>
        <Option title="cool_lexer" />
        <Option pch_mode="2" />
        <Option compiler="gcc" />
        <Build>
            <Target title="Debug">
                <Option output="bin/Debug/cool_lexer" prefix_auto="1" extension_auto="1" />
                <Option type="1" />
                <Option compiler="gcc" />
                <Option createDefines="0" />
                <Compiler>
                    <Add option="-std=c++11" />
                    <Add option="-Wall" />
                    <Add option="-Wno-unused-function" />
                    <Add option="-g" />
                </Compiler>
                <!-- Pre-build step: regenerate lex.yy.cc from cool.flex whenever you change cool.flex -->
                <ExtraCommands>
                    <Add before="flex -o lex.yy.cc cool.flex" />
                </ExtraCommands>
            </Target>
            <Target title="Release">
                <Option output="bin/Release/cool_lexer" prefix_auto="1" extension_auto="1" />
                <Option type="1" />
                <Option compiler="gcc" />
                <Option createDefines="0" />
                <Compiler>
                    <Add option="-std=c++11" />
                    <Add option="-O2" />
                    <Add option="-Wno-unused-function" />
                </Compiler>
                <ExtraCommands>
                    <Add before="flex -o lex.yy.cc cool.flex" />
                </ExtraCommands>
            </Target>
        </Build>
        <Compiler>
            <Add option="-std=c++11" />
            <Add option="-Wall" />
            <Add option="-Wno-unused-function" />
        </Compiler>
        <!-- Source files -->
        <Unit filename="cool.flex">
            <Option compile="0" />
            <Option link="0" />
        </Unit>
        <Unit filename="lex.yy.cc">
            <Option compilerVar="CPP" />
        </Unit>
        <Unit filename="stringtab.cc">
            <Option compilerVar="CPP" />
        </Unit>
        <Unit filename="utilities.cc">
            <Option compilerVar="CPP" />
        </Unit>
        <Unit filename="main.cc">
            <Option compilerVar="CPP" />
        </Unit>
        <!-- Headers (shown in project tree but not compiled directly) -->
        <Unit filename="cool-parse.h">
            <Option compile="0" />
            <Option link="0" />
        </Unit>
        <Unit filename="stringtab.h">
            <Option compile="0" />
            <Option link="0" />
        </Unit>
        <Unit filename="utilities.h">
            <Option compile="0" />
            <Option link="0" />
        </Unit>
        <!-- Test input -->
        <Unit filename="test.cl">
            <Option compile="0" />
            <Option link="0" />
        </Unit>
        <Extensions />
    </Project>
</CodeBlocks_project_file>
